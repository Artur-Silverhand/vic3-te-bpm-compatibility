					visible = "[And(Not(Law.IsActive), Not(Law.IsBeingEnacted))]"
					text = "INACTIVE_LAW"
				}

				custom_tooltip_textbox = {
					visible = "[And(Not(StringIsEmpty(Law.CannotEnactDesc)), And(Not(Law.IsActive), Not(Law.IsBeingEnacted)))]"
